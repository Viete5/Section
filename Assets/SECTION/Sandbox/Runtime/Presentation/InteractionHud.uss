.hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(240,245,248); font-size: 18px; }
.reticle { position: absolute; left: 50%; top: 50%; width: 20px; height: 24px; margin-left: -10px; margin-top: -12px; -unity-text-align: middle-center; font-size: 24px; }
.footer { position: absolute; left: 4%; right: 4%; bottom: 4%; padding: 12px 18px; background-color: rgba(18,24,29,0.88); border-left-width: 3px; border-left-color: rgb(90,180,220); }
.title { color: rgb(140,205,232); font-size: 14px; margin-bottom: 5px; }
.hint { white-space: normal; }
.diagnostics { position: absolute; top: 3%; left: 3%; padding: 12px; background-color: rgba(18,24,29,0.88); white-space: normal; font-size: 15px; }
.hidden { display: none; }
